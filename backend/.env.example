APP_ENV=development
APP_PORT=8072
APP_URL=http://localhost:8072
CORS_ORIGIN=http://localhost:3013
# Kosongkan jika langsung diakses; isi IP reverse proxy (mis. 127.0.0.1) jika di belakang nginx
TRUSTED_PROXIES=

DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos-apotek
DB_USER=
DB_PASSWORD=
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5

# Wajib, min. 32 karakter dan berbeda satu sama lain: `openssl rand -hex 32`
JWT_SECRET=
JWT_REFRESH_SECRET=

# Password user `admin` saat pertama dibuat (min. 8 karakter); kosong = password789. Wajib diganti saat login pertama.
ADMIN_DEFAULT_PASSWORD=password789

LOG_DIR=storage/logs
