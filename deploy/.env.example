# Compose variables (copy to deploy/.env).

# Public addresses the browser uses; baked into the web build.
VITE_API_URL=https://api.apotek.example/api
VITE_STORAGE_URL=https://api.apotek.example/storage/uploads

# Host ports, bound to 127.0.0.1 for the reverse proxy.
API_PORT=8072
WEB_PORT=8080

# Only with `--profile db`; use the same values in api.env (DB_HOST=db).
POSTGRES_DB=pos-apotek
POSTGRES_USER=pos
POSTGRES_PASSWORD=
