# API environment for production (copy to deploy/api.env). Never commit the filled file.
APP_ENV=production
APP_PORT=8072
APP_URL=https://api.apotek.example
# Exact origin of the web app (scheme + host, no trailing slash).
CORS_ORIGIN=https://apotek.example
# IP of the reverse proxy as seen by the container (e.g. the Docker bridge gateway 172.17.0.1), so rate limits see real client IPs.
TRUSTED_PROXIES=172.17.0.1

DB_HOST=db
DB_PORT=5432
DB_NAME=pos-apotek
DB_USER=pos
DB_PASSWORD=
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5

# Required: at least 32 characters each and different: `openssl rand -hex 32`
JWT_SECRET=
JWT_REFRESH_SECRET=

# Password of `admin` when first created (min. 8 characters); empty = password789. The admin must change it at first login.
ADMIN_DEFAULT_PASSWORD=

LOG_DIR=storage/logs
